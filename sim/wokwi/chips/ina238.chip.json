{
  "name": "BatterySentinel INA238",
  "author": "BatterySentinel N2K",
  "pins": ["VCC", "GND", "SCL", "SDA"],
  "controls": [
    {
      "id": "busVoltage",
      "label": "Battery voltage (V)",
      "type": "range",
      "min": 8,
      "max": 16,
      "step": 0.01
    },
    {
      "id": "currentA",
      "label": "Battery current (A, +charge/-discharge)",
      "type": "range",
      "min": -400,
      "max": 100,
      "step": 0.5
    },
    {
      "id": "sensorPresent",
      "label": "Sensor present (1=yes, 0=fault)",
      "type": "range",
      "min": 0,
      "max": 1,
      "step": 1
    }
  ]
}
