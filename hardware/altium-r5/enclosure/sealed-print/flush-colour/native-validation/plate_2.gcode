; update layer progress
M73 L8
M991 S0 P7 ;notify layer change


;_SET_FAN_SPEED_CHANGING_LAYER
G17
G3 Z2 I1.217 J0 P1  F36000
; object ids of layer 8 start: 1093,1104,1115,1126,1137,1148
M624 +AEAAAAAAAA=
