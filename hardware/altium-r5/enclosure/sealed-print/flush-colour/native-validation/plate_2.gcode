; other_layers_print_sequence_nums = 0
; outer_wall_acceleration = 1000
; outer_wall_filament_id = 0
; outer_wall_flow_ratio = 1
; outer_wall_jerk = 9
; outer_wall_line_width = 0.42
; outer_wall_speed = 40
; overhang_1_4_speed = 0
