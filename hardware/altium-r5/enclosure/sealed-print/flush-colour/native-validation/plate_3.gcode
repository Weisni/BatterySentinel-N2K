  M1002 gcode_claim_action : 54
  M190 S70; ensure bed temp
  M109 S140 A
  M106 S0 ; turn off fan , too noisy
  M1002 judge_flag g29_before_print_flag
  M622 J1
    M1002 gcode_claim_action : 1
    
      G29 A1 X101.05 Y90.1734 I53.9 J75.6532
    
    M400
  M623
    
  M622 J2
    M1002 gcode_claim_action : 1
    
      G29 A2 X101.05 Y90.1734 I53.9 J75.6532
    
    M400
  M623

  M622 J0
    ;skip to homing
  M623
  G29.2 S1
  G28
